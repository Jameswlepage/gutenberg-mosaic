/**
 * Suggestion capture styles - minimal and non-intrusive
 */
.editor-suggestion-capture-active {
	// Subtle visual indication that suggestion mode is active
	&::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		border: 1px solid transparent;
		border-radius: 2px;
		pointer-events: none;
		transition: border-color 0.2s ease;
	}

	&:hover::before {
		border-color: rgba(56, 88, 233, 0.3);
	}

	&.has-pending-suggestions {
		&::before {
			border-color: rgba(240, 184, 73, 0.5);
		}

		&:hover::before {
			border-color: rgba(240, 184, 73, 0.7);
		}
	}

	&.suggestion-pending {
		position: relative;

		&::after {
			content: "Pending";
			position: absolute;
			top: -8px;
			right: -8px;
			background: #f0b849;
			color: #1e1e1e;
			padding: 2px 4px;
			border-radius: 2px;
			font-size: 10px;
			font-weight: 500;
			z-index: 10;
			opacity: 0.8;
		}
	}
}

/**
 * Suggestion diff visualization
 */
.editor-suggestion-diff {
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	line-height: 1.5;
	
	&__insertion {
		background-color: #d4edda !important;
		color: #155724 !important;
		text-decoration: underline !important;
		padding: 0 2px !important;
		border-radius: 2px !important;
	}

	&__deletion {
		background-color: #f8d7da !important;
		color: #721c24 !important;
		text-decoration: line-through !important;
		padding: 0 2px !important;
		border-radius: 2px !important;
	}

	&__equal {
		// No special styling for unchanged text
	}
}

// Global styles for suggestion diff spans
.suggestion-diff-insertion {
	background-color: #d4edda !important;
	color: #155724 !important;
	text-decoration: underline !important;
	padding: 0 2px !important;
	border-radius: 2px !important;
	margin: 0 1px !important;
}

.suggestion-diff-deletion {
	background-color: #f8d7da !important;
	color: #721c24 !important;
	text-decoration: line-through !important;
